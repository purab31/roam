{
  "info": {
    "_postman_id": "roam-sprint-1-collection",
    "name": "Roam API - Sprint 1 (Auth & Profiles)",
    "description": "Postman collection for Roam Auth, Capabilities and User Profile endpoints (Sprint 1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Buyer\",\n  \"email\": \"jane.buyer@roam.local\",\n  \"mobile\": \"+15551234567\",\n  \"password\": \"Password123!\",\n  \"passwordConfirm\": \"Password123!\",\n  \"acceptTerms\": true,\n  \"capabilities\": [\"buyer\", \"renter\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.buyer@roam.local\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.buyer@roam.local\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "forgot-password"] }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<TOKEN_FROM_CONSOLE>\",\n  \"password\": \"NewPassword123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "reset-password"] }
          }
        }
      ]
    },
    {
      "name": "Users & Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/profile", "host": ["{{baseUrl}}"], "path": ["api", "users", "profile"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Buyer Updated\",\n  \"contactVisibility\": {\n    \"email\": true,\n    \"mobile\": false\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/profile", "host": ["{{baseUrl}}"], "path": ["api", "users", "profile"] }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Password123!\",\n  \"newPassword\": \"NewPassword456!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/password", "host": ["{{baseUrl}}"], "path": ["api", "users", "password"] }
          }
        },
        {
          "name": "Request Deactivation",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/api/users/account-status", "host": ["{{baseUrl}}"], "path": ["api", "users", "account-status"] }
          }
        },
        {
          "name": "Add Capability",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"capability\": \"seller\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/capabilities", "host": ["{{baseUrl}}"], "path": ["api", "users", "capabilities"] }
          }
        },
        {
          "name": "Seller Check (Capability Test)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/seller-test", "host": ["{{baseUrl}}"], "path": ["api", "users", "seller-test"] }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ]
}
