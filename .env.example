# Root Environment Example

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas Database URI
MONGODB_URI=mongodb://127.0.0.1:27017/roam?replicaSet=rs0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Sprint 2: Listings & Uploads
AUTO_APPROVE_LISTINGS=true
UPLOAD_DIR=./uploads
